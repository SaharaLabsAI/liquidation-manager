# Drill accounts: foundry keystores (~/.foundry/keystores) with an empty password. TESTNET ONLY.
# The same keys act on both chains; nonces are per chain, so the two chains can be driven in parallel.
DEPLOYER=0x07dc9C65e03d269f3E05A1C3F85E3e10a32d6783       # keystore deployer: legacy owner of MTK, both pools and registry entries
GOV_OWNER=0xE7a7da9B051D253bE872F26F576bA71A20cA3CEB      # lmtest-governance: sole owner of the 1-of-1 Governance Safe
GUARDIAN_OWNER=0x17E5EAf6eE25531C46f94Af25aFb0A081074f297 # lmtest-guardian: sole owner of the 1-of-1 Guardian Safe
GUARDIAN2=0x971c8b096863d35c3813a803f2DDC6f005a94Fc1      # lmtest-guardian2: replacement Guardian (EOA) for the recovery drill
FUNDING_OP=0x500601806A44015b1497377f493447B29DD6fB2c     # lmtest-funding: Funding Operator
RECALL_OP=0x2fAbD12628934553a5809929535463167D690Da2      # lmtest-recall: Recall Operator
RECOVERY=0x744C658Ca6f9cc502Be4E0276A6fCCD058241936       # lmtest-recovery: emergency destination for extracted reserves
BRIDGE_USER=0xB06588e58Ed0920E737F9306778e753c7e67e77e    # lmtest-user: receives the CCIP test transfers
ATTACKER=0xe228Bd12Dca34fe6eD18b266890066e1eAC32254       # lmtest-attacker: destination of the "malicious" proposal the Guardian cancels (keyed, so a mistake is recoverable)
