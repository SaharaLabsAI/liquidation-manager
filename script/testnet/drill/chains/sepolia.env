# Ethereum Sepolia. Pool, registry, router and selectors read from the live pool on 2026-10-31.
CHAIN_ID=11155111
RPC=${SEPOLIA_RPC_URL:-https://ethereum-sepolia-rpc.publicnode.com}
BLOCK_TIME=12
# Sepolia runs a newer fork than forge 1.2.3's EVM: contract creation costs ~7x more gas than forge's local estimate
# (LiquidityManager: 34.3M on Sepolia vs ~4.8M locally), so the deploy multiplies forge's estimate. Seen 2026-10-31.
FORGE_GAS_MULTIPLIER=1000
EXPLORER=https://sepolia.etherscan.io
TOKEN=0x8643a10dB4dEC8c1714213dD3313C45C3CE87416          # MTK (OZ ERC20 + Pausable + Ownable), same address on both chains
POOL=0xA864a1D27195F5b00B42f612229505bB09DFdc1d           # LockReleaseTokenPool 1.6.3-dev
TOKEN_ADMIN_REGISTRY=0x95F29FEE11c5C55d26cCcf1DB6772DE953B37B82 # TokenAdminRegistry 1.5.0
ROUTER=0x0BF3dE8c5D3e8A2B34D2BEeB17ABfCeBaf363A59         # Router 1.2.0
CHAIN_SELECTOR=16015286601757825753
REMOTE_CHAIN=bsc
